# Build-context exclusions for the Quanta CMS base image (quanta/Dockerfile).
# Everything here is either rebuilt during the image build (vendor, the Rust
# target dir) or irrelevant at runtime — keeping it out speeds up the context
# upload and prevents stale artifacts leaking into the image.

.git
.githooks
.idea
.idea*
*.swp
**/.DS_Store

# Composer output — regenerated by `composer install` inside the image.
vendor
vendor/*
composer.lock

# Runtime/site data — mounted as volumes, never baked in.
sites
sites/*
_sites
_sites/*
static/tmp
static/tmp/*

# files-db: only Cargo.toml, Cargo.lock and src/ are needed to compile the
# extension. The Rust target dir (huge) and the test/demo assets are not.
files-db/target
files-db/demo
files-db/tests/bench
files-db/.gitignore
