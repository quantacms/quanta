#!/bin/sh
set -eu

remote_name="${1:-origin}"
repo_root="$(git rev-parse --show-toplevel)"
phpcs="$repo_root/vendor/bin/phpcs"
zero_sha="0000000000000000000000000000000000000000"

tmp_files="$(mktemp "${TMPDIR:-/tmp}/quanta-phpcs.XXXXXX")"
trap 'rm -f "$tmp_files"' EXIT HUP INT TERM
result=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero_sha" ] && continue

  if [ "$remote_sha" = "$zero_sha" ]; then
    base_sha=""
    for candidate in       "refs/remotes/$remote_name/master"       "refs/remotes/$remote_name/main"       "refs/remotes/upstream/master"       "refs/remotes/upstream/main"       "refs/heads/master"       "refs/heads/main"
    do
      if git rev-parse --verify --quiet "$candidate" >/dev/null; then
        base_sha="$(git merge-base "$local_sha" "$candidate")"
        break
      fi
    done
    [ -n "$base_sha" ] || base_sha="$(git hash-object -t tree /dev/null)"
  else
    base_sha="$remote_sha"
  fi

  git diff --name-only --diff-filter=ACMR -z "$base_sha" "$local_sha" -- '*.php' '*.inc' > "$tmp_files"

  if [ -s "$tmp_files" ]; then
    if [ ! -x "$phpcs" ]; then
      echo "PHPCS is required for PHP pushes. Run composer install first." >&2
      exit 1
    fi
    echo "Running PHPCS on PHP files changed by $local_ref..."
    if ! (cd "$repo_root" && xargs -0 "$phpcs" -d memory_limit=-1 --standard="$repo_root/.phpcs.xml" < "$tmp_files"); then
      result=1
    fi
  fi
done

exit "$result"
