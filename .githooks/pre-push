#!/bin/sh

set -eu

# Resolve the shared hook directory, including hooks symlinked into site repos.
hook_dir=$(CDPATH= cd -P "$(dirname "$0")" && pwd)
if ! command -v php >/dev/null 2>&1; then
    echo "Quanta style check requires PHP. Install PHP and run composer install." >&2
    exit 1
fi

exec php "$hook_dir/../scripts/check-push-style.php" "$@"
