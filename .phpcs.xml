<?xml version="1.0"?>
<ruleset name="Quanta">
    <description>PHP coding style enforced on files changed by the pre-push hook.</description>

    <!-- PSR-12 already includes the relevant PSR-1 / PSR-2 rules. -->
    <rule ref="PSR12"/>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="160"/>
        </properties>
    </rule>

    <!-- Existing legacy code is migrated incrementally; warnings do not block pushes. -->
    <arg value="n"/>
</ruleset>
