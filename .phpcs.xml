<?xml version="1.0"?>
<ruleset name="quanta">
    <description>Quanta PHP style: PSR-12, with a 120-character line target.</description>

    <arg name="extensions" value="php,inc"/>

    <!-- Files to include -->
    <file>./src</file>

    <!-- Exclude specific files/folders test -->
    <exclude-pattern>*/tests/*</exclude-pattern>

    <!-- PSR-12 already includes PSR-1 and PSR-2. -->
    <rule ref="PSR12"/>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="160"/>
        </properties>
    </rule>

    <!-- Ignore warnings, show only errors -->
    <arg value="n"/>

    <!-- Show progress -->
    <arg value="p"/>

</ruleset>
