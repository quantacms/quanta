{
    "require": {
        "php": "^8.5",
        "matthiasmullie/minify": "^1.3",
        "phpmailer/phpmailer": "~6.0",
        "xdan/jodit": "3.1.92",
        "google/apiclient": "^2.15",
        "kreait/firebase-php": "^7.13",
        "firebase/php-jwt": "^7.0.0",
        "endroid/qr-code": "^6.0",
        "stripe/stripe-php": "^17.3"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.0",
        "behat/behat": "^4.0",
        "symfony/browser-kit": "^8.0",
        "symfony/http-client": "^8.0",
        "symfony/css-selector": "^8.0",
        "symfony/mime": "^8.0"
    },
    "scripts": {
        "test:behat": "@php tests/behat/run.php",
        "post-install-cmd": [
            "git config core.hooksPath .githooks",
            "find ./sites -type d -name .git -exec dirname {} \\; | xargs -I {} rm -rf {}/.git/hooks",
            "find ./sites -type d -name .git -exec dirname {} \\; | xargs -I {} ln -s ../../../.githooks {}/.git/hooks "
        ]
    }
}
