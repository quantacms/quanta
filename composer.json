{
    "require": {
        "php": "^8.5",
        "matthiasmullie/minify": "^1.3",
        "phpmailer/phpmailer": "~6.0",
        "xdan/jodit": "3.1.92",
        "google/apiclient": "^2.15",
        "kreait/firebase-php": "^7.13",
        "firebase/php-jwt": "^7.0.0",
        "endroid/qr-code": "^6.0",
        "stripe/stripe-php": "^17.3"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.0",
        "behat/behat": "^3.14",
        "behat/mink": "^1.12",
        "behat/mink-browserkit-driver": "^2.3",
        "symfony/browser-kit": "^7.4",
        "symfony/http-client": "^7.4",
        "silverstripe/mink-facebook-web-driver": "^2.1",
        "symfony/process": "^7.4",
        "symfony/mime": "^7.4"
    },
    "scripts": {
        "post-install-cmd": [
            "git config core.hooksPath .githooks",
            "find ./sites -type d -name .git -exec dirname {} \\; | xargs -I {} rm -rf {}/.git/hooks",
            "find ./sites -type d -name .git -exec dirname {} \\; | xargs -I {} ln -s ../../../.githooks {}/.git/hooks "
        ],
        "test:behat": "behat --strict",
        "test:behat:chrome": "behat --strict --profile=chrome"
    },
    "autoload-dev": {
        "psr-4": {
            "Quanta\\Tests\\Behat\\": "tests/behat/bootstrap/"
        }
    }
}
